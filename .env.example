# Cloudflare D1 Database ID (Found in wrangler.toml)
# DB_ID=f83fd4e9-8d94-4430-8389-d417aaa7b2f6

# Required admin passphrase for /admin and backup export.
ADMIN_PASSWORD=change-me-to-a-long-random-passphrase

# Notification Language (zh-CN, en-US)
NOTIFY_LANGUAGE=zh-CN

# Notification channels are configured in the admin dashboard and stored in D1.
